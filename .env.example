# Copy to .env and fill in. .env is gitignored; this file is not.
# Only the LLM paths (generation, coaching, judging) read these. The audio,
# modelling and site paths run without any of them.

# OpenRouter API key, from https://openrouter.ai/keys
OPENROUTER_API_KEY=

# LLM backend. "openrouter" is the only one implemented.
GANYMEDE_LLM_BACKEND=openrouter

# Set to 1 to run the three live-LLM tests (they cost API calls).
GANYMEDE_LIVE_LLM=
